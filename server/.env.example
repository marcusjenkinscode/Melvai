# Melvai API Server — copy to .env and fill in values

# Port the API server listens on
PORT=3000

# Set to 'production' in production deployments.
# When NODE_ENV=production the server will refuse to start without CORS_ORIGIN set.
NODE_ENV=development

# Base URL of the Ollama instance on this VPS
OLLAMA_BASE_URL=http://localhost:11434

# (Optional) Kimi / Moonshot AI API key for cloud model support
# Get yours at https://platform.moonshot.cn/
KIMI_API_KEY=

# Allowed origin for CORS.
# REQUIRED when NODE_ENV=production — set to your exact domain (e.g. https://melvai.com).
# For local development the default (http://localhost:5173) is used automatically.
CORS_ORIGIN=https://melvai.com
