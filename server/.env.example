# Melvai API Server — copy to .env and fill in values

# Port the API server listens on
PORT=3000

# Base URL of the Ollama instance on this VPS
OLLAMA_BASE_URL=http://localhost:11434

# (Optional) Kimi / Moonshot AI API key for cloud model support
# Get yours at https://platform.moonshot.cn/
KIMI_API_KEY=

# Allowed origin for CORS (set to your domain in production)
# Use * only during local development
CORS_ORIGIN=http://localhost:5173
